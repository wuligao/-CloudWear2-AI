.result-hero {
  display: grid;
  gap: 22rpx;
}

.poster {
  width: 100%;
  height: 760rpx;
  border-radius: 22rpx;
  background: #f7f8fc;
}

.reason {
  color: #343b49;
  font-size: 26rpx;
  line-height: 1.6;
}

.keywords {
  margin-top: 0;
}

.product-list {
  display: grid;
  gap: 18rpx;
  margin-top: 22rpx;
}

.actions {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.share-button {
  margin-top: 18rpx;
}
