page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff 0%, #fbfbfe 36%, #f5f7fb 100%);
  color: #151922;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: 1.2;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
}

.hero,
.card,
.step-card,
.product-card,
.outfit-card {
  border: 1rpx solid #edf0f7;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 48rpx rgba(31, 37, 56, 0.08);
}

.hero {
  display: flex;
  min-height: 220rpx;
  align-items: center;
  justify-content: space-between;
  padding: 38rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(249, 246, 255, 0.94) 54%, rgba(239, 247, 255, 0.94));
}

.hero-title {
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.05;
}

.hero-subtitle,
.muted {
  color: #747b8b;
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-mark {
  display: grid;
  width: 132rpx;
  height: 132rpx;
  place-items: center;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #eadfff, #e5f0ff);
  color: #7259ff;
  font-size: 64rpx;
}

.card,
.step-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-title {
  color: #171a23;
  font-size: 31rpx;
  font-weight: 900;
}

.field {
  display: grid;
  gap: 16rpx;
  margin-top: 26rpx;
}

.field-label {
  color: #343b49;
  font-size: 26rpx;
  font-weight: 800;
}

.control,
.textarea {
  width: 100%;
  border: 1rpx solid #e3e7f0;
  border-radius: 20rpx;
  background: #fff;
  color: #151922;
  font-size: 28rpx;
  min-height: 82rpx;
  padding: 0 24rpx;
}

.textarea {
  min-height: 132rpx;
  line-height: 1.45;
  padding: 22rpx 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: inline-flex;
  min-height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #f7f8fc;
  color: #626877;
  font-size: 25rpx;
  font-weight: 800;
  padding: 0 22rpx;
}

.chip.active {
  background: #f1ecff;
  color: #7259ff;
  box-shadow: inset 0 0 0 1rpx rgba(123, 81, 241, 0.22);
}

.primary-button,
.secondary-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 900;
}

.primary-button {
  background: linear-gradient(135deg, #7259ff, #955df4);
  color: #fff;
  box-shadow: 0 16rpx 32rpx rgba(114, 89, 255, 0.2);
}

.secondary-button {
  border: 1rpx solid #dfe3ec;
  color: #626877;
}

.button-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.empty {
  padding: 64rpx 28rpx;
  color: #8991a1;
  text-align: center;
}
