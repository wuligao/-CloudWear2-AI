# Copy this file to deploy/.env.deploy on the server, then fill real values.
# Do not commit deploy/.env.deploy.

CLOUDWEAR_HOST=103.242.14.110
CLOUDWEAR_API_PORT=9200
CLOUDWEAR_H5_PORT=9300
CLOUDWEAR_ADMIN_PORT=9400
CLOUDWEAR_H5_INTERNAL_PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vivy-nest-admin
MYSQL_USER=cloudwear
MYSQL_PASSWORD=CHANGE_ME

# Optional: set CREATE_DB=1 if the script should create database/user first.
CREATE_DB=0
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
MYSQL_APP_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# Optional but needed by AI generation.
OPENAI_TEXT_API_KEY=
OPENAI_TEXT_BASE_URL=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_MODEL=

# SQL import is destructive because the base SQL contains DROP TABLE.
IMPORT_SQL=0
CONFIRM_IMPORT_SQL=NO

# Set to 1 if you do not want the script to install/update Nginx config.
SKIP_NGINX=0
