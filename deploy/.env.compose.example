CLOUDWEAR_API_PORT=9200
CLOUDWEAR_H5_PORT=9300
CLOUDWEAR_ADMIN_PORT=9400
CLOUDWEAR_MYSQL_BIND_HOST=0.0.0.0
CLOUDWEAR_MYSQL_HOST_PORT=13306
CLOUDWEAR_REDIS_BIND_HOST=0.0.0.0
CLOUDWEAR_REDIS_HOST_PORT=16379
# Leave empty to let H5 call the same hostname on CLOUDWEAR_API_PORT.
# Set this only when API uses a different public domain.
NEXT_PUBLIC_API_BASE_URL=
NPM_REGISTRY=https://registry.npmmirror.com
TZ=Asia/Shanghai

# Built-in MySQL container. Change both passwords before deploying to a real server.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=vivy-nest-admin
MYSQL_USER=cloudwear
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD

# Redis is started by docker compose. The host port is only for maintenance access.
