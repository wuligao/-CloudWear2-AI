CLOUDWEAR_API_PORT=9200
CLOUDWEAR_H5_PORT=9300
NEXT_PUBLIC_API_BASE_URL=http://103.242.14.110:9200

# docker-compose.yaml uses host network on Linux servers.
# API containers can reach the server's existing MySQL/Redis through 127.0.0.1.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vivy-nest-admin
MYSQL_USER=cloudwear
MYSQL_PASSWORD=CHANGE_ME

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave REDIS_USERNAME/REDIS_PASSWORD empty when Redis has no auth.
REDIS_USERNAME=
REDIS_PASSWORD=

OPENAI_TEXT_API_KEY=
OPENAI_TEXT_BASE_URL=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_MODEL=
